# Core app configuration

# ModelsLab API key used for ModelsLab-backed models.
# Get it from: https://modelslab.com/
# Docs: https://docs.modelslab.com/authentication
MODELSLAB_API_KEY=

# Anthropic API key for direct Claude model access (claude-3-5-sonnet, claude-opus, etc.)
# Use this when routing models via the "anthropic/" prefix instead of through ModelsLab.
# Get it from: https://console.anthropic.com/settings/api-keys
# Docs: https://docs.anthropic.com/en/api/getting-started
ANTHROPIC_API_KEY=

# CodeSandbox API key used for Sandpack / preview workflows.
# Get it from your CodeSandbox account: https://codesandbox.io/signin
# Docs: https://sandpack.codesandbox.io/docs
CSB_API_KEY=

# Neon Postgres connection string used by Prisma + @neondatabase/serverless.
# Get it from: https://console.neon.tech/ -> your project -> Connect
# Docs: https://neon.com/docs/connect/connect-from-any-app
# Important: use a Neon IPv6-supported connection string. A pooled Neon host
# usually contains "-pooler" and is the best fit for this serverless app.
DATABASE_URL=
DIRECT_URL=

# Netlify OAuth client ID for the "Connect Netlify" flow.
# Create an OAuth app in Netlify, then copy the Client ID.
# Docs: https://developers.netlify.com/guides/generating-personal-access-tokens-with-netlify-oauth/
NETLIFY_CLIENT_ID=

# Supabase OAuth app credentials for the "Connect Supabase" flow.
# Create an OAuth app in Supabase Dashboard -> Organization Settings -> OAuth Apps.
# Use /api/supabase/callback as the redirect URI for your production domain.
# Docs: https://supabase.com/docs/guides/integrations/build-a-supabase-oauth-integration
SUPABASE_OAUTH_CLIENT_ID=16d7bb87-9f9d-4243-bc21-2729443797b9
SUPABASE_OAUTH_CLIENT_SECRET=sba_c9b3da036e8b114ac0f04c72682e65226bb73764

# Optional Vercel OAuth client ID/secret for the "Connect Vercel" flow.
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Optional "Sign in with Vercel" credentials.
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# UptimeHub API key for monitor/status integration.
# Get it from your UptimeHub dashboard: https://uptimehub.space/
UPTIMEHUB_API_KEY=

# Optional Microlink API key used when generating URL previews.
MICROLINK_API_KEY=

# Public base URL of your deployed app, used for absolute redirects/callbacks.
# Example: https://your-app.com
NEXT_PUBLIC_SITE_URL=

# Optional production analytics domain for Plausible.
# Example: your-app.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional local/dev base URL override used outside Vercel.
# Example: http://localhost:3000
NEXT_PUBLIC_DEVELOPMENT_URL=

# Optional directory containing Markdown design references used by the coding AI.
# Add taste-SKILL.md for universal quality rules and *-DESIGN.md files for
# selectable visual directions. The directory is rescanned automatically.
DESIGN_GUIDES_DIR=


# Stripe billing

# Get Stripe API keys from: https://dashboard.stripe.com/apikeys
# Docs: https://docs.stripe.com/keys
# Set STRIPE_LIVE_MODE=true in production to use STRIPE_LIVE_SECRET_KEY.
# Leave it blank or set to false in development to use STRIPE_TEST_SECRET_KEY.
STRIPE_LIVE_MODE=
STRIPE_TEST_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=

# Optional fallback if you want one Stripe secret key for the current environment.
STRIPE_SECRET_KEY=


# Optional scheduled subscription rewards

# Shared secret for calling /api/billing/subscriptions/rewards from your cron job.
# Use any long random string and send the same value in your production cron request.
SUBSCRIPTION_REWARD_CRON_SECRET=


# Optional local preview / thumbnail helpers

# Set to 1 to enable local preview debug behavior.
PREVIEW_DEBUG=
NEXT_PUBLIC_PREVIEW_DEBUG=

# Optional Sandpack runtime overrides for browser previews.
# Increase timeout if previews often stall before booting.
NEXT_PUBLIC_SANDPACK_TIMEOUT_MS=90000

# Optional custom/self-hosted Sandpack bundler URL.
NEXT_PUBLIC_SANDPACK_BUNDLER_URL=

# Optional CodeSandbox team id when using a managed runtime setup.
NEXT_PUBLIC_SANDPACK_TEAM_ID=

# E2B preview runtime configuration.
# E2B API key: https://e2b.dev/docs
E2B_API_KEY=
E2B_TEMPLATE=
E2B_TIMEOUT_SECONDS=3600

# Bunny.net storage settings used for preview thumbnails / media storage.
# Get these from: https://panel.bunny.net/
# Docs: https://docs.bunny.net/docs/storage-zone-api
BUNNY_STORAGE_ZONE=
BUNNY_API_KEY=
BUNNY_CDN_URL=

# Optional, defaults to storage.bunnycdn.com
BUNNY_HOSTNAME=

ANTHROPIC_API_KEY=sk-ant

# ============================================================================
# Discord Logger Configuration
# ============================================================================
# The logger uses a Discord Bot to send rich embed logs to specific channels.
# 
# Setup:
# 1. Go to https://discord.com/developers/applications
# 2. Create a New Application → go to Bot → copy the token
# 3. Enable MESSAGE CONTENT intent under Bot → Privileged Gateway Intents
# 4. Invite bot to your server with permissions: Send Messages, Embed Links, Attach Files
#    Use this URL (replace CLIENT_ID): 
#    https://discord.com/api/oauth2/authorize?client_id=CLIENT_ID&permissions=2147534848&scope=bot
# 5. Right-click each channel in Discord → Copy Channel ID (enable Developer Mode in Discord settings)
# 6. Paste the channel IDs below

# Delivery mode: 'bot' (recommended), 'webhook', or 'both'
DISCORD_LOGGER_MODE=bot

# Discord Bot Token (REQUIRED)
# Get from: https://discord.com/developers/applications → your app → Bot → Token
DISCORD_BOT_TOKEN=

# Discord Server (Guild) ID - right-click your server → Copy Server ID
DISCORD_GUILD_ID=

# --- AUTHENTICATION CHANNELS ---
# Right-click each channel → Copy Channel ID
DISCORD_CHANNEL_LOGIN_LOGS=
DISCORD_CHANNEL_REGISTER_LOGS=
DISCORD_CHANNEL_PASSWORD_LOGS=
DISCORD_CHANNEL_EMAIL_LOGS=
DISCORD_CHANNEL_TWO_FACTOR_LOGS=
DISCORD_CHANNEL_LOGOUT_LOGS=

# --- USER CHANNELS ---
DISCORD_CHANNEL_USER_ACTIVITY=
DISCORD_CHANNEL_PROFILE_UPDATES=
DISCORD_CHANNEL_SETTINGS_UPDATES=
DISCORD_CHANNEL_ACCOUNT_DELETIONS=
DISCORD_CHANNEL_USER_RESTRICTIONS=

# --- AI SYSTEM CHANNELS ---
DISCORD_CHANNEL_AI_LOGS=
DISCORD_CHANNEL_AGENT_ACTIVITY=
DISCORD_CHANNEL_IMAGE_LOGS=
DISCORD_CHANNEL_VIDEO_LOGS=
DISCORD_CHANNEL_VOICE_LOGS=
DISCORD_CHANNEL_DOCUMENT_LOGS=
DISCORD_CHANNEL_TOKEN_USAGE=
DISCORD_CHANNEL_CREDIT_USAGE=

# --- BILLING CHANNELS ---
DISCORD_CHANNEL_PAYMENT_LOGS=
DISCORD_CHANNEL_STRIPE_LOGS=
DISCORD_CHANNEL_REFUND_LOGS=
DISCORD_CHANNEL_INVOICE_LOGS=
DISCORD_CHANNEL_FREE_CREDIT_LOGS=
DISCORD_CHANNEL_TOPUP_LOGS=

# --- API CHANNELS ---
DISCORD_CHANNEL_API_REQUESTS=
DISCORD_CHANNEL_API_KEY_LOGS=
DISCORD_CHANNEL_WEBHOOK_LOGS=
DISCORD_CHANNEL_INTEGRATION_LOGS=
DISCORD_CHANNEL_RATE_LIMIT_LOGS=

# --- ADMIN CHANNELS ---
DISCORD_CHANNEL_ADMIN_ACTIONS=
DISCORD_CHANNEL_STAFF_ACTIONS=
DISCORD_CHANNEL_PERMISSION_CHANGES=
DISCORD_CHANNEL_BAN_LOGS=
DISCORD_CHANNEL_UNBAN_LOGS=

# --- SECURITY CHANNELS ---
DISCORD_CHANNEL_SECURITY_ALERTS=
DISCORD_CHANNEL_FAILED_LOGINS=
DISCORD_CHANNEL_IP_LOGS=
DISCORD_CHANNEL_SUSPICIOUS_ACTIVITY=
DISCORD_CHANNEL_ACCESS_DENIED=

# --- SYSTEM CHANNELS ---
DISCORD_CHANNEL_SERVER_STATUS=
DISCORD_CHANNEL_DEPLOYMENT_LOGS=
DISCORD_CHANNEL_RESTART_LOGS=
DISCORD_CHANNEL_BUILD_LOGS=
DISCORD_CHANNEL_SYSTEM_EVENTS=
DISCORD_CHANNEL_DATABASE_LOGS=

# --- ERROR CHANNELS ---
DISCORD_CHANNEL_WARNINGS=
DISCORD_CHANNEL_ERROR_LOGS=
DISCORD_CHANNEL_CRASH_LOGS=
DISCORD_CHANNEL_DEBUG_LOGS=
